# Copie este arquivo para .env e ajuste os valores
DJANGO_SECRET_KEY=troque-por-uma-chave-grande-e-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Sem PostgreSQL instalado? Troque para DB_ENGINE=sqlite (as linhas DB_ abaixo passam a ser ignoradas)
DB_ENGINE=postgresql
DB_NAME=carhealth
DB_USER=carhealth
DB_PASSWORD=carhealth
DB_HOST=localhost
DB_PORT=5432

# Endereços do frontend autorizados a chamar a API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Minutos sem uso até a sessão expirar e ser preciso entrar de novo (RF02)
SESSAO_INATIVIDADE_MINUTOS=30

# "Esqueci minha senha": endereço do site usado no link do e-mail
FRONTEND_URL=http://localhost:5173
# Servidor de e-mail. Vazio = o e-mail aparece no terminal do backend (bom para testar).
# Exemplo com Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_HOST_USER=seu@gmail.com e
# EMAIL_HOST_PASSWORD = "senha de app" do Google (não é a senha normal da conta)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Limite de tentativas (passou, a API responde 429)
LIMITE_LOGIN=10/min
LIMITE_RECUPERAR_SENHA=5/hour
