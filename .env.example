# Copie este arquivo para .env e ajuste os valores
DJANGO_SECRET_KEY=troque-por-uma-chave-grande-e-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=carhealth
DB_USER=carhealth
DB_PASSWORD=carhealth
DB_HOST=localhost
DB_PORT=5432

# Endereços do frontend autorizados a chamar a API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Minutos sem uso até a sessão expirar e ser preciso entrar de novo (RF02)
SESSAO_INATIVIDADE_MINUTOS=30
