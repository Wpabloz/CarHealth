{
  "info": {
    "name": "CarHealth API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Rode primeiro 'Auth > Registrar' (uma vez) ou 'Auth > Login'. O token é salvo sozinho e enviado em todas as outras chamadas."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "refresh",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Registrar (empresa + gestor)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "",
            "url": {
              "raw": "http://127.0.0.1:8000/api/auth/registrar",
              "host": [
                "127",
                "0",
                "0",
                "1"
              ],
              "path": [
                "api",
                "auth",
                "registrar"
              ],
              "protocol": "http",
              "port": "8000"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"empresa\": {\n    \"cnpj\": \"11222333000181\",\n    \"razao_social\": \"Reboques Sueli LTDA\",\n    \"telefone\": \"83999990000\",\n    \"email\": \"contato@sueli.com\"\n  },\n  \"nome\": \"Sueli Gomes\",\n  \"email\": \"sueli@sueli.com\",\n  \"password\": \"CarHealth#2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.access) { pm.collectionVariables.set('token', r.access); }",
                  "if (r.refresh) { pm.collectionVariables.set('refresh', r.refresh); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
