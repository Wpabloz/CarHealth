{
 "info": {
  "name": "CarHealth API",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
  "description": "Rode primeiro 'Auth > Registrar' (uma vez) ou 'Auth > Login'. O token é salvo sozinho e enviado em todas as outras chamadas. Depois rode as pastas na ordem. A pasta 9 entra como motorista, com o token salvo em token_motorista."
 },
 "auth": {
  "type": "bearer",
  "bearer": [
   {
    "key": "token",
    "value": "{{token}}",
    "type": "string"
   }
  ]
 },
 "variable": [
  {
   "key": "token",
   "value": ""
  },
  {
   "key": "refresh",
   "value": ""
  },
  {
   "key": "token_motorista",
   "value": ""
  },
  {
   "key": "hoje",
   "value": ""
  }
 ],
 "item": [
  {
   "name": "1. Auth",
   "description": "",
   "item": [
    {
     "name": "Registrar (empresa + gestor)",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "description": "Só na primeira vez. Cria a empresa e o primeiro GESTOR.",
      "url": {
       "raw": "http://127.0.0.1:8000/api/auth/registrar",
       "protocol": "http",
       "host": [
        "127",
        "0",
        "0",
        "1"
       ],
       "port": "8000",
       "path": [
        "api",
        "auth",
        "registrar"
       ]
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"empresa\": {\n    \"cnpj\": \"11222333000181\",\n    \"razao_social\": \"Reboques Sueli LTDA\",\n    \"telefone\": \"83999990000\",\n    \"email\": \"contato@sueli.com\"\n  },\n  \"nome\": \"Sueli Gomes\",\n  \"email\": \"sueli@sueli.com\",\n  \"password\": \"CarHealth#2026\"\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      },
      "auth": {
       "type": "noauth"
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "const r = pm.response.json();",
         "if (r.access) { pm.collectionVariables.set('token', r.access); }",
         "if (r.refresh) { pm.collectionVariables.set('refresh', r.refresh); }"
        ]
       }
      }
     ]
    },
    {
     "name": "Login (gestor)",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "description": "",
      "url": {
       "raw": "http://127.0.0.1:8000/api/auth/login",
       "protocol": "http",
       "host": [
        "127",
        "0",
        "0",
        "1"
       ],
       "port": "8000",
       "path": [
        "api",
        "auth",
        "login"
       ]
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"email\": \"sueli@sueli.com\",\n  \"password\": \"CarHealth#2026\"\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      },
      "auth": {
       "type": "noauth"
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "const r = pm.response.json();",
         "if (r.access) { pm.collectionVariables.set('token', r.access); }",
         "if (r.refresh) { pm.collectionVariables.set('refresh', r.refresh); }"
        ]
       }
      }
     ]
    },
    {
     "name": "Me (testa o token)",
     "request": {
      "method": "GET",
      "header": [],
      "description": "Devolve o perfil da conta (GESTOR ou MOTORISTA).",
      "url": {
       "raw": "http://127.0.0.1:8000/api/auth/me",
       "protocol": "http",
       "host": [
        "127",
        "0",
        "0",
        "1"
       ],
       "port": "8000",
       "path": [
        "api",
        "auth",
        "me"
       ]
      }
     }
    },
    {
     "name": "Renovar token",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "description": "",
      "url": {
       "raw": "http://127.0.0.1:8000/api/auth/refresh",
       "protocol": "http",
       "host": [
        "127",
        "0",
        "0",
        "1"
       ],
       "port": "8000",
       "path": [
        "api",
        "auth",
        "refresh"
       ]
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"refresh\": \"{{refresh}}\"\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      },
      "auth": {
       "type": "noauth"
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "const r = pm.response.json();",
         "if (r.access) { pm.collectionVariables.set('token', r.access); }",
         "if (r.refresh) { pm.collectionVariables.set('refresh', r.refresh); }"
        ]
       }
      }
     ]
    }
   ]
